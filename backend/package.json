{
  "name": "@pindian/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bootstrap/main.js",
    "start:worker": "node dist/bootstrap/worker.js",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "npm run build && node --env-file-if-exists=../.env --watch dist/bootstrap/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@pindian/contracts": "0.1.0",
    "image-size": "^2.0.2",
    "multer": "^2.0.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
