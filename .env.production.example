# 复制到独立服务器 .env.production（忽略文件），填写真实配置；不要复用模拟.env。
APP_ENV=production
RELEASE_IMAGE=pindian-api:填发布提交哈希
ADMIN_RELEASE_IMAGE=pindian-admin:填发布提交哈希
POSTGRES_USER=pindian
POSTGRES_DB=pindian
POSTGRES_PASSWORD=
PUBLIC_API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://admin.example.com
WX_APPID=
WX_APP_SECRET=
WX_PAY_MCHID=
WX_PAY_APIV3_KEY=
WX_PAY_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=/run/wechat/merchant-private.pem
WX_PAY_PLATFORM_PUBLIC_KEY_PATH=/run/wechat/platform-public.pem
WX_PAY_NOTIFY_URL=https://api.example.com/api/payments/v1/notify
WECHAT_KEYS_DIR=./data/release/keys
TLS_DIR=./data/release/tls
HTTPS_BIND=0.0.0.0:443
