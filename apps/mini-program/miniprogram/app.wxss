page{--surface:#fff;--background:#f5f5f7;--ink:#1d1d1f;--secondary:#6e6e73;--accent:#0071e3;background:#f5f5f7;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:28rpx;line-height:1.5}.page{padding:32rpx;box-sizing:border-box}.card{background:white;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx;box-sizing:border-box}.title{font-size:46rpx;font-weight:700;letter-spacing:-1rpx;margin-bottom:16rpx}.subtitle{font-size:26rpx;color:#6e6e73;line-height:1.7}.section-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.row{border-bottom:1rpx solid #e9e9ed;padding:24rpx 0;display:flex;justify-content:space-between;font-size:27rpx}.status,.hint{color:#6e6e73;font-size:24rpx;line-height:1.6}.warning,.error-text,.error-state{color:#b42318}.badge{display:inline-block;background:#edf5ff;color:#0066cc;font-size:23rpx;border-radius:12rpx;padding:8rpx 14rpx}.state{display:flex;flex-direction:column;align-items:center;gap:24rpx;padding:100rpx 24rpx;color:#6e6e73;text-align:center}.state button{width:260rpx}.source-banner{padding:16rpx 24rpx;border-radius:18rpx;background:#fff3db;color:#785400;font-size:24rpx;margin-bottom:20rpx}button{margin-top:24rpx;font-size:28rpx;background:#0071e3;color:white;border-radius:24rpx;min-height:96rpx;line-height:1.5;padding:22rpx 24rpx;box-sizing:border-box;transition:transform 120ms ease-out,opacity 120ms ease-out}button::after{border:0}button[disabled]{background:#e9e9ed!important;color:#6e6e73!important;opacity:1}.button-hover,.pressed,.hover{transform:scale(.97);opacity:.88}.primary-btn{background:#0071e3;color:white}input,textarea{color:#1d1d1f;caret-color:#0071e3}.action-card,.share-row{min-height:96rpx;box-sizing:border-box;transition:transform 120ms ease-out,background-color 220ms ease-out}.footer-bar,.panel,.bottom-bar{box-sizing:border-box}.panel{animation:sheet-enter 320ms cubic-bezier(.16,1,.3,1)}.panel-mask{animation:veil-enter 220ms ease-out}.panel-close{padding:12rpx 16rpx;min-height:96rpx;min-width:96rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center}@keyframes sheet-enter{from{transform:translateY(100%)}to{transform:translateY(0)}}@keyframes veil-enter{from{opacity:0}to{opacity:1}}@media(prefers-reduced-motion:reduce){button,.pressed,.hover,.share-row,.category-pill{transition:none!important;transform:none!important}.panel,.panel-mask{animation:none!important}}
