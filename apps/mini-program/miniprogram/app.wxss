page { background: #f4f7f6; color: #20382f; font-family: sans-serif; }.page { padding: 40rpx 32rpx; }.card { background: white; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; }.title { font-size: 42rpx; font-weight: 600; margin-bottom: 18rpx; }.subtitle { font-size: 26rpx; color: #778980; line-height: 1.7; }.badge { display: inline-block; background: #eaf4ef; color: #3d7a66; font-size: 22rpx; border-radius: 8rpx; padding: 8rpx 14rpx; margin-bottom: 20rpx; }.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 18rpx; }.row { border-bottom: 1rpx solid #edf1ee; padding: 22rpx 0; display: flex; justify-content: space-between; font-size: 26rpx; }.status { color: #7a9085; font-size: 23rpx; }.warning { color: #a84e40; font-size: 26rpx; line-height: 1.7; }button { margin-top: 24rpx; font-size: 26rpx; background: #287d68; color: white; }
