/* 地址列表样式。 */
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #6e6e73; font-size: 28rpx; text-align: center; }
.error-state { color: #b42318; }
.address-card { background: white; border-radius: 28rpx; padding: 26rpx; margin-bottom: 22rpx; display: grid; gap: 18rpx; }
.address-card.default { border: 1rpx solid #0071e3; }
.address-main { display: grid; gap: 10rpx; }
.hover { opacity: 0.85; }
.line1 { display: flex; align-items: center; gap: 14rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #1d1d1f; }
.phone { color: #515154; font-size: 26rpx; }
.default-badge { font-size: 20rpx; color: #0066cc; background: #edf5ff; border-radius: 6rpx; padding: 2rpx 10rpx; }
.detail { color: #6e6e73; font-size: 26rpx; line-height: 1.6; }
.address-actions { display: flex; gap: 12rpx; justify-content: flex-end; }
.address-actions .danger { color: #b42318; }
.count-hint { text-align: center; color: #6e6e73; font-size: 22rpx; margin: 8rpx 0 20rpx; }
.primary-btn { background: #0071e3; color: white; border-radius: 24rpx; }
/* 本页次级操作覆盖全局主按钮，保留原生loading/disabled和点击事件。 */
.list-heading{padding:12rpx 4rpx 32rpx;}.list-title{display:block;font-size:44rpx;font-weight:600;letter-spacing:-1rpx;}.list-caption{display:block;color:#6e6e73;font-size:26rpx;margin-top:10rpx;line-height:1.5;}
.address-card{padding:32rpx;gap:22rpx;border-radius:28rpx;}.address-card.default{border:0;}.line1{flex-wrap:wrap;gap:12rpx;}.name{font-size:32rpx;}.phone{font-size:26rpx;}.default-badge{margin-left:auto;font-size:22rpx;padding:5rpx 12rpx;border-radius:8rpx;}.detail{color:#515154;font-size:27rpx;line-height:1.65;}.address-actions{justify-content:space-between;align-items:center;gap:8rpx;padding-top:14rpx;border-top:1rpx solid #ededf0;}.edit-actions{display:flex;gap:8rpx;}.address-actions button{margin:0;padding:0 20rpx;min-width:96rpx;height:96rpx;min-height:96rpx;line-height:1.4;display:flex;align-items:center;justify-content:center;font-size:25rpx;border-radius:20rpx;}.address-actions .default-action{background:#f5f5f7;color:#515154;}.address-actions .edit-action{background:transparent;color:#515154;}.address-actions .delete-action{background:#fff1f0;color:#b42318;}.address-actions button[disabled]{background:#f5f5f7!important;color:#6e6e73!important;}
