/* 地址表单样式。 */
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #6e6e73; font-size: 28rpx; text-align: center; }
.error-state { color: #b42318; }
.card { background: white; border-radius: 28rpx; padding: 10rpx 28rpx; margin-bottom: 24rpx; display: grid; }
.field { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e9e9ed; }
.field text { width: 140rpx; color: #515154; font-size: 26rpx; padding-top: 6rpx; flex-shrink: 0; }
.field input, .field textarea { flex: 1; font-size: 28rpx; color: #1d1d1f; }
.region-value { font-size: 28rpx; color: #1d1d1f; }
.error-text { color: #b42318; font-size: 24rpx; margin: 0 8rpx 20rpx; }
.primary-btn { background: #0071e3; color: white; border-radius: 24rpx; }

.address-heading{font-size:46rpx;letter-spacing:-1rpx;font-weight:700;margin:8rpx 0 12rpx}.location-btn{background:#e6f1ff;color:#0066cc;margin:28rpx 0}.location-hint{font-size:24rpx;color:#6e6e73;margin-bottom:24rpx}.field{padding:30rpx 0}.field input,.field textarea{min-width:0;width:100%}.field picker{flex:1;min-width:0}.primary-btn{width:100%}
