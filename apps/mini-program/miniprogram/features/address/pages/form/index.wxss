/* 地址表单样式。 */
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #7b8b85; font-size: 28rpx; text-align: center; }
.error-state { color: #a74337; }
.card { background: white; border-radius: 16rpx; padding: 10rpx 28rpx; margin-bottom: 24rpx; display: grid; }
.field { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f0f3f1; }
.field text { width: 140rpx; color: #54657a; font-size: 26rpx; padding-top: 6rpx; flex-shrink: 0; }
.field input, .field textarea { flex: 1; font-size: 28rpx; color: #223247; }
.region-value { font-size: 28rpx; color: #223247; }
.error-text { color: #a74337; font-size: 24rpx; margin: 0 8rpx 20rpx; }
.primary-btn { background: #287d68; color: white; border-radius: 12rpx; }
