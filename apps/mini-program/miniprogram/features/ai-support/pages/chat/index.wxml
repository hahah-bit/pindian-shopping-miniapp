<view class="chat-shell" style="padding-bottom: {{keyboardHeight}}px">
  <view class="chat-top"><view><text class="chat-title">有问题，聊一聊。</text><text class="chat-caption">AI 智能客服 · 回复可能有误，请核实。订单、退款和发货请联系人工客服。</text></view><button class="human-link" bindtap="human">人工客服</button></view>
  <scroll-view class="conversation" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation enhanced>
    <view class="chat-content">
      <view wx:if="{{loading}}" class="state">正在读取对话…</view>
      <view wx:elif="{{!loggedIn}}" class="welcome"><text class="welcome-title">先登录，再聊聊。</text><text>对话只对你可见。</text><button class="primary-btn" bindtap="login">微信登录</button></view>
      <block wx:else>
        <button wx:if="{{nextBefore}}" class="history-button" bindtap="older" loading="{{olderLoading}}" disabled="{{olderLoading}}">更早的对话</button>
        <view wx:if="{{!messages.length}}" class="welcome"><text class="welcome-title">你好，我在这里。</text><text>我能解释拼单规则和页面操作。
订单进度、退款或发货，请联系人工客服。</text>
          <button data-text="怎么参与拼单？" bindtap="quick">怎么参与拼单？</button><button data-text="怎么添加收货地址？" bindtap="quick">怎么添加收货地址？</button>
        </view>
        <view wx:for="{{messages}}" wx:key="clientMessageId" id="turn-{{item.clientMessageId}}" class="turn">
          <view class="user-message"><text selectable>{{item.text}}</text></view>
          <view class="assistant-label">AI 智能客服</view>
          <view class="assistant-message"><text wx:if="{{item.reply}}" selectable>{{item.reply}}</text><text wx:elif="{{item.status === 'pending'}}" class="pending-text">{{sending ? '正在想一想…' : '回复待确认，可刷新查看或重试'}}</text><text wx:else class="pending-text">暂时没有收到回复</text></view>
          <button wx:if="{{item.status !== 'completed' && !sending}}" class="retry-button" data-id="{{item.clientMessageId}}" bindtap="retryTurn">重试这条消息</button>
        </view>
      </block>
      <view class="chat-bottom" id="conversation-bottom"></view>
    </view>
  </scroll-view>
  <view wx:if="{{error}}" class="chat-error"><text>{{error}}</text><button bindtap="refresh" disabled="{{sending}}">刷新</button></view>
  <view wx:if="{{loggedIn}}" class="composer"><input class="message-input" value="{{draft}}" placeholder="想问点什么？" maxlength="1000" bindinput="input" bindconfirm="send" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" confirm-type="send" disabled="{{sending}}"/><button class="send-button primary-btn" bindtap="send" loading="{{sending}}" disabled="{{sending || !draft}}">发送</button></view>
</view>
