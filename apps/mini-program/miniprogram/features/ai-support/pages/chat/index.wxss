.chat-shell{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:#f5f5f7;}
.chat-top{padding:20rpx 28rpx;display:flex;align-items:center;gap:14rpx;background:#fff;}.chat-heading{flex:1;min-width:0;}.chat-title{display:block;font-size:32rpx;font-weight:600;letter-spacing:-.5rpx;}.chat-caption{display:block;font-size:23rpx;color:#6e6e73;margin-top:6rpx;line-height:1.5;}.human-link{margin:0;padding:0 12rpx;min-width:144rpx;height:96rpx;min-height:96rpx;display:flex;align-items:center;justify-content:center;color:#0066cc;background:transparent;font-size:24rpx;}
.conversation{flex:1;min-height:0;height:0;}.chat-content{padding:28rpx;}.welcome{padding:56rpx 8rpx 28rpx;text-align:center;}.welcome>text{display:block;white-space:pre-wrap;}.welcome-title{color:#1d1d1f;font-size:44rpx;font-weight:600;letter-spacing:-1rpx;margin:28rpx 0 14rpx;}.welcome-copy{color:#6e6e73;font-size:28rpx;line-height:1.7;}.welcome>.primary-btn{margin:32rpx auto 0;width:280rpx;}.quick-questions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:42rpx;}.quick-questions button{margin:0;padding:20rpx 12rpx;min-height:96rpx;display:flex;align-items:center;justify-content:center;background:#fff;color:#515154;font-size:26rpx;border-radius:24rpx;}
.turn{margin-bottom:36rpx;}.user-message{width:fit-content;max-width:85%;box-sizing:border-box;margin-left:auto;background:#0071e3;color:#fff;border-radius:26rpx 26rpx 6rpx 26rpx;padding:20rpx 26rpx;white-space:pre-wrap;line-height:1.65;overflow-wrap:anywhere;}.assistant-label{font-size:23rpx;color:#6e6e73;margin:24rpx 0 10rpx 8rpx;}.assistant-message{margin-right:28rpx;padding:24rpx 26rpx;border-radius:6rpx 26rpx 26rpx 26rpx;background:#fff;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;color:#1d1d1f;}.reply-text{animation:reply-in 180ms ease-out;}.pending-text{color:#6e6e73;font-size:26rpx;}.thinking-dots{display:flex;gap:8rpx;margin:4rpx 0 16rpx;}.thinking-dots>view{width:9rpx;height:9rpx;border-radius:50%;background:#0071e3;}.thinking-dots.moving>view{animation:dot-pulse 1.4s ease-in-out infinite;}.thinking-dots>view:nth-child(2){animation-delay:160ms;}.thinking-dots>view:nth-child(3){animation-delay:320ms;}
.retry-button,.history-button{background:transparent;color:#0066cc;font-size:25rpx;padding:20rpx 8rpx;margin:0;text-align:left;min-height:96rpx;min-width:96rpx;}.retry-button{width:fit-content;}.history-button{text-align:center;}.chat-error{padding:12rpx 28rpx;background:#fff1f0;color:#b42318;font-size:25rpx;display:flex;align-items:center;gap:12rpx;}.chat-error>text{flex:1;}.chat-error button{margin:0;background:transparent;font-size:25rpx;color:#b42318;padding:0 12rpx;min-width:96rpx;min-height:96rpx;display:flex;align-items:center;justify-content:center;}
.chat-footnote{display:flex;align-items:center;justify-content:space-between;gap:8rpx;padding:0 28rpx;background:#f5f5f7;color:#6e6e73;font-size:22rpx;}.motion-toggle{margin:0;background:transparent;color:#6e6e73;font-size:22rpx;padding:0 8rpx;height:96rpx;min-height:96rpx;min-width:112rpx;display:flex;align-items:center;justify-content:center;}.composer{padding:16rpx 24rpx;display:flex;align-items:flex-end;gap:14rpx;background:#fff;}.message-input{flex:1;min-height:96rpx;max-height:220rpx;border-radius:24rpx;background:#f5f5f7;padding:26rpx 24rpx;line-height:1.5;min-width:0;box-sizing:border-box;font-size:28rpx;}.input-placeholder{color:#6e6e73;}.send-button{margin:0;width:120rpx;min-width:120rpx;height:96rpx;min-height:96rpx;padding:0 12rpx;font-size:28rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;}.chat-bottom{height:12rpx;}.loading-state{padding:60rpx 8rpx;color:#6e6e73;font-size:25rpx;}.skeleton{height:80rpx;background:#e9e9ed;border-radius:20rpx;margin-bottom:24rpx;}.skeleton.short{width:55%;margin-left:auto;}
@keyframes reply-in{from{opacity:.5;}to{opacity:1;}}@keyframes dot-pulse{0%,100%{opacity:.4;transform:translateY(0);}50%{opacity:1;transform:translateY(-3rpx);}}.still .reply-text{animation:none;}
@media(prefers-reduced-motion:reduce){.reply-text,.thinking-dots.moving>view{animation:none;}}
/* 真实导购快照，卡片入口只走本项目详情；不使用模型生成的链接。 */
.product-links{margin:14rpx 28rpx 0 0;display:grid;gap:12rpx;}.recommended-product{margin:0;width:100%;min-height:148rpx;padding:20rpx;display:flex;align-items:center;gap:20rpx;box-sizing:border-box;text-align:left;background:#fff;color:#1d1d1f;border-radius:24rpx;line-height:1.5;transition:opacity 120ms ease-out;}.product-pressed{opacity:.85;}.recommendation-image{flex:none;width:112rpx;height:112rpx;border-radius:16rpx;overflow:hidden;background:#f5f5f7;}.image-placeholder{display:flex;align-items:center;justify-content:center;color:#6e6e73;font-size:25rpx;}.recommendation-info{flex:1;min-width:0;}.recommendation-name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:28rpx;font-weight:500;overflow-wrap:anywhere;}.recommendation-price{display:block;margin-top:7rpx;font-size:27rpx;font-weight:600;font-variant-numeric:tabular-nums;}.reference-label{font-size:22rpx;color:#6e6e73;font-weight:400;margin-left:8rpx;}.recommendation-action{display:flex;align-items:center;gap:8rpx;margin-top:8rpx;font-size:24rpx;color:#0066cc;}.recommendation-arrow{width:8rpx;height:8rpx;border-top:2rpx solid #0066cc;border-right:2rpx solid #0066cc;transform:rotate(45deg);}.still .recommended-product{transition:none;}@media(prefers-reduced-motion:reduce){.recommended-product{transition:none;}}
