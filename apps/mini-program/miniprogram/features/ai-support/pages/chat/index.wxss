.chat-shell{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:#f5f5f7;}
.chat-top{padding:30rpx 32rpx 24rpx;display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #e7e7ec;background:#fff;}.chat-top>view{flex:1;}.chat-title{display:block;font-size:36rpx;font-weight:600;letter-spacing:-1rpx;}.chat-caption{display:block;font-size:23rpx;color:#6e6e73;margin-top:10rpx;line-height:1.5;}.human-link{margin:0;padding:0 16rpx;min-width:136rpx;min-height:96rpx;display:flex;align-items:center;color:#0071e3;background:transparent;font-size:25rpx;}
.conversation{flex:1;min-height:0;height:0;}.chat-content{padding:32rpx;}.welcome{padding:60rpx 12rpx;line-height:1.7;color:#6e6e73;}.welcome>text{display:block;white-space:pre-wrap;}.welcome-title{color:#1d1d1f;font-size:44rpx;font-weight:600;letter-spacing:-1rpx;margin-bottom:18rpx;}.welcome button{margin:24rpx 0 0;text-align:left;padding:20rpx 28rpx;background:#fff;color:#0071e3;border-radius:24rpx;}.turn{margin-bottom:40rpx;}.user-message{margin-left:60rpx;background:#0071e3;color:#fff;border-radius:26rpx 26rpx 6rpx 26rpx;padding:24rpx 28rpx;white-space:pre-wrap;line-height:1.65;}.assistant-label{font-size:23rpx;color:#6e6e73;margin:28rpx 0 12rpx;}.assistant-message{padding:4rpx 4rpx 0;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;color:#1d1d1f;}.pending-text{color:#6e6e73;}.retry-button,.history-button{background:transparent;color:#0071e3;font-size:25rpx;padding:20rpx 0;margin:4rpx 0;text-align:left;min-height:96rpx;}.history-button{text-align:center;}.chat-error{padding:16rpx 32rpx;background:#fff1f0;color:#b42318;font-size:25rpx;display:flex;align-items:center;gap:20rpx;}.chat-error>text{flex:1;}.chat-error button{background:transparent;font-size:25rpx;color:#b42318;padding:8rpx 18rpx;min-height:96rpx;}
.composer{padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:16rpx;background:#fff;border-top:1rpx solid #e7e7ec;}.message-input{flex:1;height:96rpx;border-radius:24rpx;background:#f5f5f7;padding:0 24rpx;min-width:0;box-sizing:border-box;}.send-button{margin:0;width:120rpx;min-height:96rpx;padding:16rpx;font-size:28rpx;border-radius:24rpx;}.chat-bottom{height:20rpx;}
