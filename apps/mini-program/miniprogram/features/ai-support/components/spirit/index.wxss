:host{display:block;flex:none;}
.spirit{position:relative;width:180rpx;height:188rpx;margin:0 auto;}
.body{position:absolute;top:32rpx;left:21rpx;width:138rpx;height:126rpx;background:#0071e3;border-radius:48rpx 48rpx 42rpx 42rpx;transform:rotate(-4deg);}
.face{position:absolute;inset:0;}.eye{position:absolute;top:43rpx;width:12rpx;height:21rpx;background:white;border-radius:10rpx;transform-origin:center;}.left{left:44rpx;}.right{right:38rpx;}.smile{position:absolute;left:61rpx;top:78rpx;width:18rpx;height:9rpx;border-bottom:3rpx solid white;border-radius:0 0 16rpx 16rpx;}
.hand{position:absolute;right:-11rpx;top:74rpx;width:20rpx;height:35rpx;background:#0071e3;border-radius:16rpx;transform:rotate(-28deg);}.antenna{position:absolute;left:93rpx;top:13rpx;width:4rpx;height:26rpx;background:#0071e3;transform:rotate(12deg);}.antenna-tip{position:absolute;left:-5rpx;top:-3rpx;width:14rpx;height:14rpx;border-radius:50%;background:#0071e3;}.shadow{position:absolute;left:52rpx;bottom:11rpx;width:76rpx;height:8rpx;background:#dfe8f1;border-radius:50%;}
.moving .body,.moving .antenna{animation:float 4.8s ease-in-out infinite;}.moving .eye{animation:blink 5.6s linear infinite;}.moving .hand{animation:wave 9s ease-in-out infinite;}.moving.thinking .body{animation:ponder 2.4s ease-in-out infinite;}.thinking .smile{width:9rpx;height:9rpx;border:3rpx solid white;border-radius:50%;}.compact{width:80rpx;height:84rpx;}.compact .body{top:14rpx;left:9rpx;width:62rpx;height:57rpx;border-radius:22rpx 22rpx 19rpx 19rpx;}.compact .eye{top:19rpx;width:6rpx;height:10rpx;}.compact .left{left:19rpx;}.compact .right{right:17rpx;}.compact .smile{left:27rpx;top:35rpx;width:8rpx;height:4rpx;border-bottom-width:2rpx;}.compact.thinking .smile{width:4rpx;height:4rpx;border-width:2rpx;}.compact .antenna{left:42rpx;top:6rpx;width:2rpx;height:12rpx;}.compact .antenna-tip{left:-3rpx;width:8rpx;height:8rpx;}.compact .hand{right:-5rpx;top:34rpx;width:9rpx;height:16rpx;}.compact .shadow{left:23rpx;bottom:5rpx;width:34rpx;height:4rpx;}
@keyframes float{0%,100%{transform:translateY(0) rotate(-4deg);}50%{transform:translateY(-5rpx) rotate(-2deg);}}
@keyframes blink{0%,42%,46%,49%,53%,100%{transform:scaleY(1);}44%,51%{transform:scaleY(.12);}}
@keyframes wave{0%,8%,100%{transform:rotate(-28deg);}3%,6%{transform:rotate(-46deg);}}
@keyframes ponder{0%,100%{transform:rotate(-4deg);}50%{transform:rotate(4deg);}}
@media(prefers-reduced-motion:reduce){.moving .body,.moving.thinking .body,.moving .antenna,.moving .eye,.moving .hand{animation:none;}}
