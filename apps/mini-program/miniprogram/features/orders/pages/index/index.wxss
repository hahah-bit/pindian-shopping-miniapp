/* 订单列表样式。 */
.notice { background: #fff7e6; color: #a06724; font-size: 22rpx; padding: 12rpx 24rpx; border-radius: 8rpx; margin-bottom: 20rpx; }
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #6e6e73; font-size: 28rpx; text-align: center; }
.error-state { color: #b42318; }
.order-card { background: white; border-radius: 28rpx; padding: 26rpx; margin-bottom: 22rpx; display: grid; gap: 14rpx; }
.hover { opacity: 0.85; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.order-no { font-size: 26rpx; color: #1d1d1f; font-weight: 600; }
.status { font-size: 24rpx; color: #a06724; }
.status.paid { color: #0066cc; }
.status.cancelled, .status.expired { color: #6e6e73; }
.row2 { display: flex; justify-content: space-between; color: #515154; font-size: 26rpx; }
.amount { color: #1d1d1f; font-weight: 700; font-size: 30rpx; }
.row3 { display: flex; justify-content: space-between; align-items: center; }
.time { color: #6e6e73; font-size: 22rpx; }
.danger { color: #b42318; }
.load-more { text-align: center; color: #6e6e73; font-size: 24rpx; padding: 20rpx 0 40rpx; }
/* 下单是主动作，取消保留为中性次级动作。 */
.list-heading{padding:12rpx 4rpx 28rpx;}.list-title{display:block;font-size:44rpx;font-weight:600;letter-spacing:-1rpx;}.list-caption{display:block;color:#6e6e73;font-size:26rpx;margin-top:10rpx;line-height:1.5;}.notice{background:transparent;color:#6e6e73;padding:0 4rpx 24rpx;font-size:24rpx;margin:0;line-height:1.6;}.order-card{padding:30rpx 32rpx;gap:24rpx;}.row1{gap:16rpx;}.order-no{min-width:0;overflow-wrap:anywhere;font-size:24rpx;color:#6e6e73;font-weight:400;}.status{flex:none;font-size:23rpx;padding:6rpx 12rpx;border-radius:8rpx;background:#fff7e6;}.status.paid{background:#edf5ff;}.status.cancelled,.status.expired{background:#f5f5f7;}.row2{align-items:center;font-size:28rpx;}.amount{font-size:36rpx;font-weight:600;font-variant-numeric:tabular-nums;}.row3{gap:12rpx;border-top:1rpx solid #ededf0;padding-top:12rpx;}.time{font-size:23rpx;}.order-card .cancel-button{margin:0;background:#f5f5f7;color:#515154;min-width:152rpx;height:96rpx;min-height:96rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:center;line-height:1.4;border-radius:20rpx;font-size:25rpx;}
