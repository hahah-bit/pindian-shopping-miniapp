<view class="page">
  <view class="notice">微信支付暂未开放，开放后可支付该订单</view>

  <view wx:if="{{loading}}" class="state">正在加载订单…</view>

  <view wx:elif="{{notFound}}" class="state">
    <text>订单不存在或已被删除</text>
  </view>

  <view wx:elif="{{error}}" class="state error-state">
    <text>{{error}}</text>
    <button bindtap="retry" type="button">重试</button>
  </view>

  <block wx:elif="{{order}}">
    <view class="card">
      <view class="row1">
        <text class="status">{{statusText}}</text>
        <text wx:if="{{countdownText}}" class="countdown">{{countdownText}}</text>
      </view>
      <view class="order-no">订单号 {{order.orderNo}}</view>
    </view>

    <view class="card">
      <view class="section-title">金额明细（整数分，展示为元）</view>
      <view class="amount-row"><text>商品金额</text><text>¥{{goodsText}}</text></view>
      <view class="amount-row"><text>平台服务费</text><text>¥{{serviceText}}</text></view>
      <view wx:if="{{tailText}}" class="amount-row"><text>尾差调整（{{order.quote.isFinalOrder ? '最后单' : ''}}）</text><text>¥{{tailText}}</text></view>
      <view class="amount-row total"><text>应付金额</text><text class="total-amount">¥{{amountText}}</text></view>
      <view class="hint">参考价与实际报价以本页应付金额为准。</view>
    </view>

    <view class="card">
      <view class="section-title">份额</view>
      <view class="amount-row"><text>购买份额</text><text>{{order.units}}/60 单位</text></view>
      <view class="amount-row"><text>商品数量参考</text><text>{{order.productSnapshot.wholeQuantityText}} {{order.productSnapshot.unit}}/件 × 份额 ≈ {{order.productSnapshot.referenceQuantityText}} {{order.productSnapshot.unit}}（参考，非履约数量）</text></view>
    </view>

    <view class="card">
      <view class="section-title">收货信息（下单时快照）</view>
      <view class="address">{{order.addressSnapshot.receiverName}} {{order.addressSnapshot.phone}}</view>
      <view class="address-sub">{{order.addressSnapshot.province}}{{order.addressSnapshot.city}}{{order.addressSnapshot.district}} {{order.addressSnapshot.detail}}</view>
      <view class="hint">地址后续修改不影响本订单。</view>
    </view>

    <button wx:if="{{canCancel}}" class="pay-btn" bindtap="initiatePay" loading="{{busy}}" disabled="{{busy}}">发起支付</button>
    <button wx:if="{{canCancel}}" class="danger-btn" bindtap="cancelOrder" loading="{{busy}}" disabled="{{busy}}">取消订单</button>
  </block>
</view>
