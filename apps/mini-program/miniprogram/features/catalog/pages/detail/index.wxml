<view class="page detail-page">
  <view wx:if="{{isMock}}" class="source-banner">Mock 数据预览（platform/config.ts 可切换 api）</view>

  <view wx:if="{{loading}}" class="state">正在加载商品…</view>

  <view wx:elif="{{notFound}}" class="state">
    <text>商品已下架或不存在</text>
    <button bindtap="retry" type="button">刷新重试</button>
  </view>

  <view wx:elif="{{error}}" class="state error-state">
    <text>{{error}}</text>
    <button bindtap="retry" type="button">重试</button>
  </view>

  <block wx:else>
    <swiper wx:if="{{gallery.length}}" class="gallery" indicator-dots="{{gallery.length > 1}}" circular="{{gallery.length > 1}}">
      <swiper-item wx:for="{{gallery}}" wx:key="url">
        <view class="gallery-slide">
          <image
            class="gallery-image {{item.failed ? 'image-failed' : ''}}"
            src="{{item.url}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onImageError"
            bindtap="previewImage"
            data-index="{{index}}"
          />
          <view wx:if="{{item.failed}}" class="image-placeholder">图片加载失败</view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="gallery-empty">暂无商品图片</view>

    <view class="card">
      <view class="title-row">
        <text class="name">{{name}}</text>
        <text class="stock {{soldOut ? 'sold-out' : ''}}">{{soldOut ? '已售罄' : '有货'}}</text>
      </view>
      <view class="price-block">
        <view class="price-line"><text class="price-main">整件参考价 ¥{{wholePriceText}}</text><text class="price-note">含 5 元服务费</text></view>
        <view class="price-line"><text class="price-from">¥{{fromPriceText}}/份 起</text><text class="price-note">整件 {{quantitySummary}}</text></view>
      </view>
      <text wx:if="{{description}}" class="description">{{description}}</text>
    </view>

    <view class="card">
      <view class="section-title">可拼份额（参考）</view>
      <view
        wx:for="{{shareOptions}}"
        wx:key="units"
        class="share-row {{selectedUnits === item.units ? 'selected' : ''}} {{soldOut ? 'disabled' : ''}}"
        data-units="{{item.units}}"
        bindtap="toggleSelectShare"
        hover-class="hover"
      >
        <text class="share-label">{{item.fractionLabel}}</text>
        <text class="share-quantity">{{item.quantityText}} {{unit}}</text>
        <text class="share-price">{{selectedUnits === item.units ? '已选' : '选择'}} ¥{{item.priceText}}</text>
      </view>
      <view class="hint">参考价按份额均摊四舍五入到分，仅用于展示；拼单开放后以下单时实际报价为准。</view>
    </view>

    <view class="card">
      <view class="section-title">商品介绍</view>
      <text wx:if="{{description}}" class="description">{{description}}</text>
      <text wx:else class="hint">商家暂未填写详细介绍。</text>
    </view>

    <view class="footer-bar">
      <text wx:if="{{soldOut}}" class="footer-soldout">已售罄</text>
      <button wx:else class="footer-btn {{selectedUnits === null ? 'disabled' : ''}}" bindtap="openOrderPanel">
        {{selectedUnits === null ? '选择份额下单' : '确认下单（已选 ' + selectedUnits + '/60 单位）'}}
      </button>
      <text class="footer-note-inline">微信支付暂未开放</text>
    </view>

    <view wx:if="{{orderPanelOpen}}" class="panel-mask" bindtap="closeOrderPanel">
      <view class="panel" catchtap="">
        <view class="panel-head">
          <text class="panel-title">确认下单</text>
          <text class="panel-close" bindtap="closeOrderPanel">关闭</text>
        </view>
        <view class="panel-row">
          <text class="panel-label">份额</text>
          <text class="panel-value">{{selectedUnits}}/60 单位（参考数量与价格以提交结果为准）</text>
        </view>
        <view class="panel-row">
          <text class="panel-label">收货地址</text>
          <text class="panel-value" bindtap="goToAddresses">{{selectedAddress ? selectedAddress.label : '暂无地址，点击去新建 →'}}</text>
        </view>
        <view wx:if="{{orderError}}" class="panel-error">{{orderError}}</view>
        <button class="panel-submit" bindtap="submitOrder" loading="{{placingOrder}}" disabled="{{placingOrder || !selectedAddress}}">
          {{placingOrder ? '正在提交…' : '提交订单（服务端生成报价）'}}
        </button>
        <view class="panel-hint">提交即锁定份额（15 分钟），金额由服务端计算；微信支付暂未开放。</view>
      </view>
    </view>
  </block>
</view>
