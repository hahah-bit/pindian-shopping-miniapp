/* 商品详情页样式。 */
.detail-page { padding-bottom: 140rpx; }
.source-banner { background: #fff7e6; color: #a06724; font-size: 22rpx; padding: 12rpx 24rpx; border-radius: 8rpx; margin-bottom: 20rpx; }
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #7b8b85; font-size: 28rpx; text-align: center; }
.error-state { color: #a74337; }
.gallery { height: 560rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.gallery-slide { position: relative; }
.gallery-image { width: 100%; height: 560rpx; background: #eef2f0; }
.image-failed { visibility: hidden; }
.image-placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: #a5b3ad; font-size: 24rpx; background: #eef2f0; }
.gallery-empty { height: 240rpx; display: grid; place-items: center; color: #a5b3ad; background: #eef2f0; border-radius: 16rpx; margin-bottom: 24rpx; font-size: 26rpx; }
.card { background: white; border-radius: 16rpx; padding: 26rpx; margin-bottom: 24rpx; display: grid; gap: 16rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.name { font-size: 34rpx; font-weight: 700; color: #223247; flex: 1; }
.stock { font-size: 22rpx; color: #356557; background: #eaf3ef; border-radius: 6rpx; padding: 6rpx 14rpx; }
.stock.sold-out { color: #a06724; background: #fdf1e3; }
.price-block { display: grid; gap: 10rpx; }
.price-line { display: flex; align-items: baseline; gap: 14rpx; }
.price-main { color: #d0563f; font-size: 38rpx; font-weight: 700; }
.price-from { color: #d0563f; font-size: 30rpx; font-weight: 600; }
.price-note { color: #a5b3ad; font-size: 22rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #223247; }
.share-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f0f3f1; }
.share-row:last-of-type { border-bottom: none; }
.share-label { font-size: 30rpx; font-weight: 600; color: #287d68; }
.share-quantity { color: #54657a; font-size: 26rpx; }
.share-price { color: #d0563f; font-size: 30rpx; font-weight: 700; }
.description { color: #54657a; font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; }
.hint { color: #a5b3ad; font-size: 22rpx; line-height: 1.6; }
.footer-note { position: fixed; left: 0; right: 0; bottom: 0; background: #f2f4f3; color: #7b8b85; text-align: center; padding: 26rpx 0 calc(26rpx + env(safe-area-inset-bottom)); font-size: 26rpx; }
