.discover-page{padding:24rpx 32rpx 48rpx}.discover-head{padding:8rpx 0 12rpx}.discover-title{font-size:56rpx;line-height:1.2;font-weight:700;letter-spacing:-1.5rpx;margin-bottom:16rpx}.title-soft{color:#6e6e73;display:block}.search-field{display:flex;align-items:center;height:96rpx;border-radius:24rpx;background:#e9e9ed;margin:32rpx 0 26rpx;padding:0 26rpx}.search-field input{flex:1;min-width:0;font-size:28rpx;height:100%;margin-left:20rpx}.search-icon{width:25rpx;height:25rpx;border:3rpx solid #6e6e73;border-radius:50%;position:relative;flex-shrink:0}.search-icon::after{content:'';position:absolute;width:12rpx;height:3rpx;background:#6e6e73;transform:rotate(45deg);right:-9rpx;bottom:-5rpx}.search-clear{background:transparent;color:#0066cc;padding:0 0 0 16rpx;width:96rpx;min-width:96rpx;min-height:96rpx;margin:0;font-size:24rpx}.category-scroll{white-space:nowrap;width:100%}.category-track{display:inline-flex;gap:12rpx;padding:2rpx 0 12rpx}.category-pill{display:inline-flex;min-height:96rpx;align-items:center;padding:0 26rpx;border-radius:40rpx;background:white;font-size:25rpx;color:#515154;transition:background-color 220ms ease-out,color 220ms ease-out,transform 120ms ease-out}.category-pill.active{background:#1d1d1f;color:white}.collection-header{display:flex;justify-content:space-between;align-items:baseline;margin:24rpx 0;font-size:34rpx;font-weight:600}.collection-count{color:#6e6e73;font-size:23rpx;font-weight:400}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx 20rpx}.product-card{background:white;border-radius:28rpx;overflow:hidden;transition:transform 180ms cubic-bezier(.16,1,.3,1)}.product-photo{position:relative;height:340rpx;background:#e9e9ed}.product-photo image{display:block;width:100%;height:100%}.photo-placeholder{display:flex;align-items:center;justify-content:center;height:100%;font-size:23rpx;color:#6e6e73}.photo-stock{position:absolute;left:16rpx;bottom:16rpx;border-radius:16rpx;background:#fff;padding:8rpx 16rpx;font-size:22rpx;color:#6e6e73}.product-info{padding:22rpx 22rpx 26rpx}.product-name{font-size:28rpx;font-weight:500;line-height:1.45;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.product-price{font-size:38rpx;font-weight:600;letter-spacing:-.7rpx;margin-top:16rpx}.currency{font-size:25rpx;margin-right:3rpx}.price-unit{font-size:21rpx;font-weight:400;letter-spacing:0;color:#6e6e73}.product-whole{font-size:22rpx;color:#6e6e73;margin-top:8rpx}.list-end{text-align:center;font-size:23rpx;color:#6e6e73;padding:48rpx 0 12rpx}.skeleton-card{border-radius:28rpx;background:white;padding-bottom:24rpx;overflow:hidden}.skeleton-photo{height:340rpx;background:#e5e5ea}.skeleton-line{height:24rpx;margin:22rpx;width:65%;border-radius:8rpx;background:#ededf0}.skeleton-line.short{width:40%}.empty-title{font-size:34rpx;font-weight:600;color:#1d1d1f}
