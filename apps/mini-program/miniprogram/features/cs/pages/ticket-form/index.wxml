<view class="page"><view class="card"><view class="section-title">提交售后工单</view><text wx:if="{{loading}}">正在读取订单…</text><view wx:if="{{error}}" class="error-state">{{error}}<button bindtap="load">重试加载</button></view><picker disabled="{{awaiting || busy}}" range="{{types}}" value="{{typeIndex}}" bindchange="onType"><view>问题类型：{{types[typeIndex]}}</view></picker><picker disabled="{{awaiting || busy}}" range="{{orders}}" range-key="label" value="{{orderIndex}}" bindchange="onOrder"><view>关联订单：{{orders[orderIndex].label}}</view></picker><input placeholder="标题（60字以内）" maxlength="60" disabled="{{awaiting || busy}}" value="{{title}}" bindinput="onTitle"/><textarea placeholder="描述遇到的问题（2000字以内）" maxlength="2000" disabled="{{awaiting || busy}}" value="{{description}}" bindinput="onDescription"/><button bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !title || !description}}">{{awaiting ? '重试原工单' : '提交工单'}}</button><view wx:if="{{awaiting}}">上次提交尚未确认；重试会恢复同一工单。<button bindtap="discard" disabled="{{busy}}">放弃重试，重新编辑</button></view></view></view>
