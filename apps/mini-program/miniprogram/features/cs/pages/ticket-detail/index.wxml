<view class="page"><view wx:if="{{loading}}" class="state">正在读取工单…</view><view wx:if="{{error}}" class="error-state">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{ticket}}" class="card"><view class="section-title">{{ticket.title}}</view><view>{{statusText}}</view><view class="description">{{ticket.description}}</view><view wx:for="{{actions}}" wx:key="index" class="ticket-row"><view>{{item.label}} · {{item.time}}</view><view>{{item.text}}</view></view><view wx:for="{{requests}}" wx:key="id" class="ticket-row"><view>{{item.label}}</view><view>{{item.text}}</view></view><view wx:if="{{awaiting}}">上次反馈尚未确认。<button bindtap="retry" disabled="{{busy}}">重试原反馈</button><button bindtap="discard" disabled="{{busy}}">放弃重试</button></view><block wx:if="{{ticket.status === 'resolved' || ticket.status === 'waiting_feedback'}}"><textarea maxlength="2000" placeholder="补充反馈" value="{{text}}" disabled="{{awaiting || busy}}" bindinput="onText"/><button bindtap="feedback" data-satisfied="{{true}}" disabled="{{busy || awaiting}}">问题已解决</button><button bindtap="feedback" data-satisfied="{{false}}" disabled="{{busy || awaiting}}">仍未解决，继续处理</button></block></view></view>
