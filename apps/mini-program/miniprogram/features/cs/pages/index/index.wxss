.page { padding: 24rpx; }
.card { background: white; border-radius: 28rpx; padding: 26rpx; margin-bottom: 22rpx; display: grid; gap: 14rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #1d1d1f; }
.hint { color: #6e6e73; font-size: 22rpx; line-height: 1.6; }
.conv-status { font-size: 26rpx; color: #515154; }
.primary-btn { background: #0071e3; color: white; border-radius: 24rpx; }
.state { display: grid; gap: 18rpx; justify-items: center; padding: 120rpx 40rpx; color: #6e6e73; font-size: 28rpx; text-align: center; }
.error-state { color: #b42318; }
.ticket-row { padding: 12rpx 0; border-bottom: 1rpx solid #e9e9ed; }
.ticket-title { font-size: 26rpx; color: #1d1d1f; }
.ticket-meta { font-size: 22rpx; color: #6e6e73; margin-top: 4rpx; }
