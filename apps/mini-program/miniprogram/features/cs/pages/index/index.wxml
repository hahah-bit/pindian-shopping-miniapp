<view class="page">
  <view class="card"><view class="section-title">AI 智能客服</view><view class="hint">拼单规则、页面操作，随时问问。AI 回复请核实，订单和售后请联系人工客服。</view><button class="primary-btn" bindtap="openAi">开始对话</button></view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text>{{error}}</text>
    <button bindtap="retry" type="button">重试</button>
  </view>
  <block wx:else>
    <view class="card">
      <view class="section-title">在线客服</view>
      <block wx:if="{{conversation}}">
        <view class="conv-status">当前会话：{{conversation.hasAgent ? '客服接待中' : '等待客服接入（当前为留言）'}}</view>
        <button class="primary-btn" bindtap="openChat" data-id="{{conversation.id}}">继续会话</button>
      </block>
      <block wx:else>
        <view class="hint">有问题？联系在线客服，支持文字、图片与订单/商品卡片。</view>
        <button class="primary-btn" bindtap="startChat" loading="{{submitting}}" disabled="{{submitting}}">发起咨询</button>
      </block>
    </view>

    <view class="card">
      <view class="section-title">我的售后工单</view>
      <button bindtap="create">提交售后工单</button>
      <view wx:if="{{!tickets.length}}" class="hint">暂无工单。</view>
      <view wx:for="{{tickets}}" wx:key="id" class="ticket-row" bindtap="openTicket" data-id="{{item.id}}">
        <view>
          <view class="ticket-title">{{item.title}}</view>
          <view class="ticket-meta">{{item.typeText}} · {{item.statusText}}</view>
        </view>
      </view>
      <button wx:if="{{tickets.length < ticketTotal}}" bindtap="moreTickets">更多工单</button>
    </view>
    <view class="card"><view class="section-title">历史会话</view><view wx:if="{{!history.length}}" class="hint">暂无历史会话</view><view wx:for="{{history}}" wx:key="id" class="ticket-row" bindtap="openChat" data-id="{{item.id}}">{{item.statusText}} · 点击查看</view><button wx:if="{{history.length < historyTotal}}" bindtap="moreHistory">更多会话</button>
    </view>
  </block>
</view>
