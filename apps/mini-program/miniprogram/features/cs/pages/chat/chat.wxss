.page { display: flex; flex-direction: column; height: 100vh; background: #f2f6f4; }
.status-bar { display: flex; justify-content: space-between; padding: 16rpx 24rpx; font-size: 24rpx; color: #7b8b85; background: #fff; }
.end-link { color: #a74337; }
.messages { flex: 1; padding: 20rpx; box-sizing: border-box; }
.msg-row { display: grid; gap: 4rpx; margin-bottom: 18rpx; }
.msg-row.self { justify-items: end; }
.bubble { max-width: 70%; padding: 16rpx 22rpx; border-radius: 14rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.bubble.self { background: #d0563f; color: white; }
.bubble.other { background: white; color: #223247; }
.time { font-size: 20rpx; color: #a5b3ad; }
.composer { display: flex; gap: 12rpx; padding: 16rpx; background: white; }
.composer input { flex: 1; background: #f2f6f4; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.composer button { background: #d0563f; color: white; border-radius: 10rpx; font-size: 26rpx; }
