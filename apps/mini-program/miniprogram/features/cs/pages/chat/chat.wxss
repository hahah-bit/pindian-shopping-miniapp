.page { display: flex; flex-direction: column; height: 100vh; background: #f2f6f4; }
.status-bar { display: flex; justify-content: space-between; padding: 16rpx 24rpx; font-size: 24rpx; color: #6e6e73; background: #fff; }
.end-link { color: #b42318; }
.messages { flex: 1; padding: 20rpx; box-sizing: border-box; }
.msg-row { display: grid; gap: 4rpx; margin-bottom: 18rpx; }
.msg-row.self { justify-items: end; }
.bubble { max-width: 70%; padding: 16rpx 22rpx; border-radius: 14rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.bubble.self { background: #1d1d1f; color: white; }
.bubble.other { background: white; color: #1d1d1f; }
.time { font-size: 20rpx; color: #6e6e73; }
.composer { display: flex; gap: 12rpx; padding: 16rpx; background: white; }
.composer input { flex: 1; background: #f2f6f4; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.composer button { background: #1d1d1f; color: white; border-radius: 10rpx; font-size: 26rpx; }
.bubble image { width: 320rpx; max-width: 100%; }
.attachments { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; background: white; padding: 12rpx 20rpx; }
.attachments picker { max-width: 400rpx; font-size: 24rpx; }
.attachments button { margin: 0; font-size: 24rpx; }
