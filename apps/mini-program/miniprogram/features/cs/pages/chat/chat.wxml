<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载会话…</view>
  <view wx:if="{{error}}" class="state error-state">
    <text>{{error}}</text>
    <button bindtap="retry" type="button">重试</button>
  </view>
  <block wx:if="{{!loading}}">
    <view class="status-bar">
      <text>{{status === 'queued' ? '等待客服接入（当前为留言）' : status === 'active' ? (hasAgent ? '客服接待中' : '等待接入') : '会话已结束'}}</text>
      <text wx:if="{{status === 'queued' || status === 'active'}}" class="end-link" bindtap="endSession">结束会话</text>
    </view>
    <scroll-view class="messages" scroll-y scroll-into-view="{{scrollInto}}">
      <view wx:for="{{messages}}" wx:key="seq" id="msg-{{item.seq}}" class="msg-row {{item.self ? 'self' : 'other'}}">
        <view class="bubble {{item.self ? 'self' : 'other'}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="widthFix" data-path="{{item.image}}" bindtap="preview"/><text wx:else>{{item.text}}</text></view>
        <view class="time">{{item.timeText}}</view>
      </view>
    </scroll-view>
    <button wx:if="{{hasMore}}" bindtap="loadMore">继续加载消息</button>
    <view wx:if="{{status === 'queued' || status === 'active'}}" class="composer">
      <input value="{{input}}" bindinput="onInput" placeholder="输入消息…" confirm-type="send" bindconfirm="send" disabled="{{pending || sending}}" />
      <button bindtap="send" loading="{{sending}}" disabled="{{sending || (!input && !pending)}}">{{pending ? '重试' : '发送'}}</button>
    </view>
    <view wx:if="{{pending}}" class="status-bar"><text>消息尚未确认，重试不会重复发送。</text><text bindtap="discard">取消重试</text></view>
    <view wx:if="{{status === 'queued' || status === 'active'}}" class="attachments">
      <button bindtap="chooseImage" disabled="{{sending || pending}}">图片</button>
      <picker range="{{cardKinds}}" value="{{cardKindIndex}}" bindchange="onCardKind"><view>{{cardKinds[cardKindIndex]}}卡片</view></picker>
      <picker range="{{options}}" range-key="label" value="{{optionIndex}}" bindchange="onCardOption"><view>{{options.length ? options[optionIndex].label : '暂无相关业务'}}</view></picker>
      <button bindtap="sendCard" disabled="{{sending || pending || !options.length}}">发送卡片</button>
    </view>
  </block>
</view>
