# 本地联调配置。先执行 npm run env:init 生成随机密码，不用于公网部署。
POSTGRES_USER=pindian
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=pindian
POSTGRES_PORT=5433
API_PORT=3000
ADMIN_PORT=8080
DATABASE_URL=postgresql://pindian:replace-with-random-local-password@127.0.0.1:5433/pindian
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 可选缓存服务：docker compose --profile cache up -d
REDIS_PORT=6379
# T002：图片访问地址（真机/局域网联调时改为局域网 IP，如 http://192.168.x.x:3000）
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# T002：管理员会话有效期（分钟，默认 720）
ADMIN_SESSION_TTL_MINUTES=720
# T002：初始管理员凭据（仅 npm run admin:init 读取；凭据不进入源码、镜像和日志）
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
# T006：微信支付商户配置（全部留空时支付接口返回“未配置”，不伪造渠道成功）
WX_PAY_MCHID=
# 以下为敏感凭据，不进入 Git、日志或响应
WX_PAY_APIV3_KEY=
WX_PAY_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=
# 平台公钥/微信支付公钥 PEM（回调强制验签；未配置时回调一律拒绝）
WX_PAY_PLATFORM_PUBLIC_KEY_PATH=
WX_PAY_NOTIFY_URL=http://localhost:3000/api/payments/v1/notify
# T003：微信小程序凭据（留空时微信登录返回"未配置"，不伪造成功；凭据不进入源码与日志）
WX_APPID=
WX_APP_SECRET=
APP_ENV=local
# 仅本地/模拟装置覆盖，production 启动时禁止。
WX_API_BASE_URL=
WX_PAY_ENDPOINT_BASE=
# T003：用户会话有效期（分钟，默认 20160 = 14 天）
USER_SESSION_TTL_MINUTES=20160

# F051 智能客服：仅服务端配置；空配置关闭AI，人工客服仍可用
AI_SUPPORT_API_KEY=
AI_SUPPORT_BASE_URL=https://api.deepseek.com/v1
AI_SUPPORT_MODEL=deepseek-flash
